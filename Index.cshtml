@{
    ViewData["Title"] = "Backend2";
}

<div class="container">
    <h1 class="text-center mb-4">Backend2</h1>
    <h2 class="text-center mb-4">Form parameters parsing demo</h2>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4>Calculator Form</h4>
                </div>
                <div class="card-body">
                    <form method="post" action="/Home/Calculate" id="calcForm">
                        <div class="mb-3">
                            <label class="form-label">First Number:</label>
                            <input type="number" name="firstNumber" class="form-control" value="5" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Operation:</label>
                            <select name="operation" class="form-select" required>
                                <option value="+">+ Addition</option>
                                <option value="-">- Subtraction</option>
                                <option value="*">* Multiplication</option>
                                <option value="/">/ Division</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Second Number:</label>
                            <input type="number" name="secondNumber" class="form-control" value="3" required>
                        </div>

                        <button type="submit" class="btn btn-success w-100">Calculate</button>
                        <button type="button" class="btn btn-outline-secondary w-100 mt-2" onclick="generateRandom()">
                            Generate Random Numbers
                        </button>
                    </form>

                    <!-- Real-time calculation -->
                    <div class="mt-3 p-3 bg-light rounded">
                        <h5>Real-time Calculation:</h5>
                        <div id="realTimeResult">Enter numbers to see result</div>
                    </div>
                </div>
            </div>

            @if (ViewBag.Result != null)
            {
                <div class="alert alert-success mt-3">
                    <h4>Result: @ViewBag.Result</h4>
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3">
                    <h4>Error: @ViewBag.Error</h4>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/js/forms.js"></script>